{
  "name": "LogResponse",
  "type": "object",
  "properties": {
    "log_id": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_role": {
      "type": "string"
    },
    "response_type": {
      "type": "string",
      "enum": [
        "acknowledge",
        "add perspective",
        "clarify",
        "build on observation"
      ]
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "log_id",
    "response_type",
    "body"
  ]
}