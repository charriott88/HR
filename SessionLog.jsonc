{
  "name": "SessionLog",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_role": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "R&D",
        "Development",
        "Rehearsal",
        "Pre-shoot",
        "Shoot",
        "Post-production / Performance"
      ]
    },
    "prompt": {
      "type": "string",
      "default": "What shifted?"
    },
    "text_entry": {
      "type": "string"
    },
    "energy_clarity_score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "tagged_collaborators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thread_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prompt_id": {
      "type": "string"
    }
  },
  "required": [
    "text_entry"
  ]
}